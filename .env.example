# AlphaSwarm Configuration
# All vars prefixed with ALPHASWARM_
# Nested settings use __ delimiter

ALPHASWARM_DEBUG=false
ALPHASWARM_LOG_LEVEL=INFO

# ── Browser origins and trusted hosts ─────────────────────────────────────────
# The API and /ws/state have no authentication, so the server answers only these
# Host header values (DNS-rebinding defence) and accepts state-changing requests
# and WebSocket handshakes only from these browser origins. Requests without an
# Origin header (curl, scripts) are unaffected. The defaults cover the Vite dev
# server (5173) and the built UI on uvicorn (8000) on both loopback spellings.
# Trusted hosts are names or addresses only (no scheme, no port; a wildcard only
# as a leading "*."). A malformed host or origin entry stops the server at startup.
# To serve the UI on a LAN address, set BOTH (JSON lists), for example:
# ALPHASWARM_TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]","192.168.1.20"]
# ALPHASWARM_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","http://192.168.1.20:8000"]
# ALPHASWARM_WS_ALLOWED_ORIGINS and ALPHASWARM_HTTP_ALLOWED_ORIGINS were replaced
# by ALPHASWARM_ALLOWED_ORIGINS and are ignored (the server logs a warning).

# ── Paths ─────────────────────────────────────────────────────────────────────
# Relative paths resolve against the repository root, not the directory the
# server is started from. Defaults shown; uncomment to override.
# ALPHASWARM_REPORTS_DIR=reports
# ALPHASWARM_ADVISORY_DIR=advisory
# ALPHASWARM_HOLDINGS_CSV_PATH=Schwab/holdings.csv
# ALPHASWARM_INFERENCE_CONFIG_PATH=.secrets/inference.json
# Your ticker -> sector map for the advisory (gitignored; without it the fictional
# examples/sector_map.example.json is used). Read on every advisory run.
# ALPHASWARM_SECTOR_MAP_PATH=data/sector_map.local.json
# Advisory files hold cost-basis exposure, so after each write only the newest N
# advisory/*_advisory.json files are kept (minimum 1).
# ALPHASWARM_ADVISORY_KEEP_LAST=20

# ── Local Ollama (DEFAULT inference backend) ──────────────────────────────────
# These vars configure the on-device Ollama server used when no cloud provider
# is configured. For cloud / API inference, use the Settings UI in the web app
# or edit .secrets/inference.json directly — that file is gitignored and is the
# single source of truth for provider selection, model, API key, rate limits,
# and spend cap. No environment variables control cloud provider selection.
ALPHASWARM_OLLAMA__ORCHESTRATOR_MODEL=qwen3.6:27b-nvfp4
ALPHASWARM_OLLAMA__WORKER_MODEL=qwen3.6:35b-a3b-nvfp4
ALPHASWARM_OLLAMA__NUM_PARALLEL=16
ALPHASWARM_OLLAMA__MAX_LOADED_MODELS=2
ALPHASWARM_OLLAMA__BASE_URL=http://localhost:11434
ALPHASWARM_OLLAMA__CONNECT_TIMEOUT_S=5
ALPHASWARM_OLLAMA__WORKER_READ_TIMEOUT_S=120
ALPHASWARM_OLLAMA__ORCHESTRATOR_READ_TIMEOUT_S=600
ALPHASWARM_OLLAMA__ORCHESTRATOR_MODEL_ALIAS=alphaswarm-orchestrator
ALPHASWARM_OLLAMA__WORKER_MODEL_ALIAS=alphaswarm-worker

# Neo4j
# PASSWORD is REQUIRED and has no default: the app refuses to open a Neo4j
# connection when it is unset, and `docker compose up` aborts when it is unset
# or empty. docker-compose.yml reads THIS variable (Compose loads .env from the
# repo root), so one value configures both the server and the client.
#
# Generate one per install:  openssl rand -hex 32
# Hex keeps the value free of "/" and "$", which carry special meaning in
# NEO4J_AUTH and in .env values respectively.
#
# Tests never use this database or this password: the Neo4j tests run against
# the throwaway neo4j-test container on 127.0.0.1:7688 (scripts/neo4j_test.sh up).
ALPHASWARM_NEO4J__URI=bolt://localhost:7687
ALPHASWARM_NEO4J__USERNAME=neo4j
ALPHASWARM_NEO4J__PASSWORD=
ALPHASWARM_NEO4J__DATABASE=neo4j
# Per-transaction timeout (s) and the wait for a pooled connection (s).
# ALPHASWARM_NEO4J__QUERY_TIMEOUT_S=30.0
# ALPHASWARM_NEO4J__CONNECTION_ACQUISITION_TIMEOUT=10.0

# Resource Governor
ALPHASWARM_GOVERNOR__BASELINE_PARALLEL=8
ALPHASWARM_GOVERNOR__MAX_PARALLEL=16
ALPHASWARM_GOVERNOR__MEMORY_THROTTLE_PERCENT=80.0
ALPHASWARM_GOVERNOR__MEMORY_PAUSE_PERCENT=90.0
ALPHASWARM_GOVERNOR__CHECK_INTERVAL_SECONDS=2.0
ALPHASWARM_GOVERNOR__FAILURE_WINDOW_SIZE=20
ALPHASWARM_GOVERNOR__FAILURE_REGROW_SUCCESSES=10
# Abort a round (nothing persisted) when more than this percent of agents fail.
# ALPHASWARM_GOVERNOR__ROUND_ABORT_FAILURE_PERCENT=50.0

# Peer selection (docs/DECISIONS.md#adr-diverse-peer-context). Defaults shown;
# change them only for experiments. Every cycle records the effective values
# in its metrics (peer_limit, peer_min_brackets, peer_bracket_cap, ...).
# ALPHASWARM_SIMULATION__PEER_LIMIT=10
# ALPHASWARM_SIMULATION__MIN_BRACKETS=4
# ALPHASWARM_SIMULATION__BRACKET_CAP=3
# ALPHASWARM_SIMULATION__PERSONAL_BOOST=0.3
# ALPHASWARM_SIMULATION__PEER_BUDGET_CHARS=4000

# Experiment knobs, fast-track subset (docs/DECISIONS.md#adr-diverse-peer-context).
# ALPHASWARM_SIMULATION__OWN_PRIOR_MEMORY=true
# ALPHASWARM_SIMULATION__CONTROL_FRACTION=0.0            # 0..0.5
